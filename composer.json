{
    "name": "lancasters/elasticsearch-bundle",
    "description": "Elasticsearch bundle for Symfony.",
    "type": "symfony-bundle",
    "homepage": "http://ongr.io",
    "license": "MIT",
    "authors": [
        {
            "name": "ONGR team",
            "homepage": "http://www.ongr.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^5.0|^6.0|^7.0",
        "symfony/dependency-injection": "^5.0|^6.0|^7.0",
        "symfony/console": "^5.0|^6.0|^7.0",
        "symfony/stopwatch": "^5.0|^6.0|^7.0",
        "symfony/finder": "^5.0|^6.0|^7.0",
        "symfony/serializer": "^5.0|^6.0|^7.0",
        "symfony/cache": "^5.4.52|^6.4.40|^7.4.12",
        "symfony/property-access": "^5.0|^6.0|^7.0",
        "doctrine/annotations": "^1.6",
        "doctrine/cache": "^1.7",
        "doctrine/inflector": "^1.3",
        "doctrine/collections": "^1.5",
        "monolog/monolog": "^1.24|^2.0|^3.0",
        "elasticsearch/elasticsearch": "^7.17.2",
        "handcraftedinthealps/elasticsearch-dsl": "^7.0"
    },
    "require-dev": {
        "mikey179/vfsstream": "~1.6",
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.0",
        "symfony/browser-kit" : "^5.0|^6.0|^7.0",
        "symfony/expression-language" : "^5.0|^6.0|^7.0",
        "symfony/twig-bundle": "^5.0|^6.0|^7.0",
        "symfony/yaml": "^5.4.54|^6.4.45|^7.4.18",
        "symfony/validator": "^5.4.43|^6.4.11|^7.1.4",
        "symfony/options-resolver": "^5.0|^6.0|^7.0"
    },
    "autoload": {
        "psr-4": { "ONGR\\ElasticsearchBundle\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "files": [
            "Tests/app/AppKernel.php"
        ],
        "psr-4": {
            "ONGR\\App\\": "\\Tests\\app\\src\\"
        }
    },
    "minimum-stability": "dev",
    "extra": {
    }
}
